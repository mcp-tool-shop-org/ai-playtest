{
  "name": "@mcptoolshop/ai-playtest",
  "version": "0.1.0",
  "description": "Family-diverse AI playtesting for turn-based text games: model players over stdio, structured critiques, an aggregated verdict report.",
  "type": "module",
  "private": true,
  "bin": {
    "ai-playtest": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm test",
    "playtest": "node dist/cli.js",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "mcp-tool-shop",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/ai-playtest.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
